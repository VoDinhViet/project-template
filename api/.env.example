# Sao chép thành .env.local khi chạy dev. Không commit file .env*.
NODE_ENV=local
PORT=4000

# Origin của web (BFF), dùng cho CORS ở route file có URL ký.
WEB_ORIGIN=http://localhost:3010

# mysql://<user>:<password>@<host>:<port>/<database>
# Local: user `qlda`, mật khẩu = QLDA_PASSWORD trong docker/.env.
DATABASE_URL=mysql://qlda:change-me-app@127.0.0.1:3306/quan_ly_du_an
# Shared hosting giới hạn số kết nối; giữ nhỏ.
DATABASE_POOL_MAX=5

# Tối thiểu 16 ký tự. INTERNAL_API_KEY phải trùng với web/.env.
INTERNAL_API_KEY=change-me-internal-key

# Tuỳ chọn. Email Google nhận vai trò toàn quyền "Chủ sở hữu" ở lần đăng nhập đầu, chỉ khi hệ thống
# chưa có ai giữ vai trò đó (cài đặt mới). Sau đó để trống hay giữ nguyên đều không có tác dụng.
BOOTSTRAP_OWNER_EMAIL=

# Service account của Firebase (Project settings → Service accounts → Generate new private key).
# Lấy 3 trường project_id, client_email, private_key trong file JSON tải về. Không commit.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nguyên chuỗi một dòng có ký tự \n như trong file JSON, bọc nháy kép.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web API key (Project settings → General), trùng VITE_FIREBASE_API_KEY của web. Dùng để gia hạn phiên
# bằng refresh token; key không được giới hạn theo HTTP referrer vì api gọi từ server.
FIREBASE_API_KEY=

# Gửi email lời mời qua Resend; để trống cả hai thì tắt (link mời vẫn hiện để gửi tay). Có một thì phải có cả hai.
# Tạo key ở Resend → API Keys; MAIL_FROM phải thuộc tên miền đã xác minh (`Tên <email@miền>` hoặc `email@miền`).
# `onboarding@resend.dev` chỉ gửi được tới email chủ tài khoản Resend.
RESEND_API_KEY=
MAIL_FROM=
# Tuỳ chọn. Khoá AES-256 mã hoá email lỗi chờ gửi lại (thư mời chứa link mời nên không để dạng rõ trong DB).
# Tạo bằng: openssl rand -base64 32. Để trống thì email gửi lỗi không được cất để gửi lại.
MAIL_OUTBOX_KEY=

# Tuỳ chọn. Secret của route cron POST /api/cron/send-emails (header X-Cron-Secret), ít nhất 32 ký tự,
# không bắt đầu bằng `change-me`. Để trống thì route trả 404. Tạo bằng: openssl rand -hex 32.
CRON_SECRET=
