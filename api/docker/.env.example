# Sao chép thành api/docker/.env (đã gitignore). Mật khẩu chỉ dùng cho DB local; không dùng dấu nháy.
MARIADB_ROOT_PASSWORD=change-me-root
# User cho api (Drizzle migration + chạy app). Phải khớp DATABASE_URL trong api/.env.local.
QLDA_PASSWORD=change-me-app
# User chỉ có SELECT, dùng cho MySQL MCP.
QLDA_RO_PASSWORD=change-me-readonly
