# Sao chép thành .env khi chạy dev. Chỉ đọc phía server (server function); KHÔNG đặt secret sau tiền tố VITE_.
# Địa chỉ api (NestJS) mà BFF gọi tới.
API_URL=http://localhost:4000
# Phải trùng INTERNAL_API_KEY của api/.env.local.
INTERNAL_API_KEY=change-me-internal-key

# Khoá mã hoá cookie phiên (iron-session), tối thiểu 32 ký tự ngẫu nhiên. Đổi khoá = mọi người bị đăng xuất.
# Tạo bằng: openssl rand -hex 32
SESSION_SECRET=

# Cấu hình web của Firebase (công khai, được phép đặt sau VITE_). Lấy bằng Firebase MCP `firebase_get_sdk_config`
# hoặc Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
